# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""

# Public site URL, used for absolute links in emails and metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
