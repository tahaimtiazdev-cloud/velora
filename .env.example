# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres).
# If using Neon's pooled/transaction-mode endpoint, make sure the string
# includes pgbouncer=true (src/lib/db.ts adds it automatically if missing).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# Required ONLY when running a production build (`npm run build && npm run
# start`) locally — Auth.js refuses to trust "localhost" as a host outside
# of dev mode otherwise, which silently breaks every sign-in/sign-up call.
# Not needed on Vercel (the deployment's own host is auto-trusted) and
# should NOT be set in that environment.
# AUTH_TRUST_HOST="true"

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From a webhook endpoint pointed at <your-deployed-url>/api/webhooks/stripe
# (Stripe Dashboard → Developers → Webhooks, test mode), or create one via
# the API with stripe.webhookEndpoints.create() to get the secret directly.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend — https://resend.com/api-keys. Optional: order-confirmation email
# is silently skipped (never blocks an order) if this is unset.
RESEND_API_KEY=""

# The site's own public URL. Used for absolute links in emails, sitemap.xml,
# structured data, and — critically — Stripe's checkout success/cancel
# redirect URLs. NEXT_PUBLIC_* vars are inlined at BUILD time, so on Vercel
# this must be set as a real Environment Variable (not just in a .env file)
# for the Production environment, pointing at the actual deployed domain —
# otherwise Stripe will redirect real customers back to localhost after
# they pay. Redeploy after changing it; setting it alone does nothing to
# an already-built deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
